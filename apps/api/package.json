{
  "name": "@forkcast/api",
  "version": "0.1.0",
  "private": true,
  "description": "Forkcast API: Express + Mongoose, platform adapters, pricing engine, seed data",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "scrape": "tsx src/scrape.ts",
    "scrape:watch": "tsx src/scrape.ts --every 30",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "playwright": "^1.56.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
