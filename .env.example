# MongoDB Atlas. Build the URI from your Atlas cluster's "Connect your application" dialog.
# Never commit the real value. The API reads this at startup.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/forkcast?retryWrites=true&w=majority
# mock | live   (live = run the DoorDash / Uber Eats / Grubhub scrapers)
ADAPTER=mock
PORT=4000
