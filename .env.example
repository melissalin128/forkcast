# MongoDB Atlas. Build the URI from your Atlas cluster's "Connect your application" dialog.
# Never commit the real value. The API reads this at startup.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/forkcast?retryWrites=true&w=majority
# mock | live   (live = run the DoorDash / Uber Eats / Grubhub scrapers)
ADAPTER=mock
PORT=4000

# ---------------------------------------------------------------------------
# Optional: live delivery quotes from the platforms' OFFICIAL partner APIs.
# Used only by `npm run ingest -- --only livequotes` (src/ingest/liveQuotes.ts).
# Leave blank and that stage skips itself; the rest of the ingest runs fine.
#
# DoorDash Drive — free sandbox, sign up at https://developer.doordash.com/portal
#   (production access is gated behind certification; sandbox is enough for a demo)
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
#
# Uber Direct — free sandbox, sign up at https://direct.uber.com
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=

# Optional: Apify token for bulk DoorDash / Uber Eats catalogue ingest
# (`npm run ingest -- --only apify`). Never commit the real token.
APIFY_TOKEN=
