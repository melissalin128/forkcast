# MongoDB Atlas. Build the URI from your Atlas cluster's "Connect your application" dialog.
# Never commit the real value. The API reads this at startup.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/forkcast?retryWrites=true&w=majority
# mock | live | apify
#   live  = run the DoorDash / Uber Eats / Grubhub Playwright scrapers locally
#   apify = let Apify actors do the crawling (everything below)
ADAPTER=mock
# Per-platform override of ADAPTER (same values). Lets one platform run in a
# different mode, e.g. ADAPTER=apify with Grubhub on the local scraper:
# ADAPTER_GRUBHUB=live
# ADAPTER_DOORDASH=
# ADAPTER_UBEREATS=
PORT=4000

# --- Apify (ADAPTER=apify) -------------------------------------------------
# Token: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Actor ids are the "username/actor-name" from the actor's store URL
# (https://apify.com/<username>/<actor-name>). Pick one per platform from
# https://apify.com/store?search=doordash (also: ubereats, grubhub).
# Only the platforms you set an actor for are collected; the rest report an error.
APIFY_DOORDASH_ACTOR=
APIFY_UBEREATS_ACTOR=
APIFY_GRUBHUB_ACTOR=

# Actors this project uses. Their input templates are the built-in defaults, so
# the actor id on its own is enough:
# APIFY_UBEREATS_ACTOR=borderline/uber-eats-scraper-ppr   ($0.005 per restaurant, menu included)
# APIFY_DOORDASH_ACTOR=dz_omar/doordash-scraper           ($0.006 per store record, menu included)

# Optional: a different actor for single-store/menu runs (defaults to the search actor).
# APIFY_DOORDASH_STORE_ACTOR=
# APIFY_UBEREATS_STORE_ACTOR=
# APIFY_GRUBHUB_STORE_ACTOR=

# Optional: actor input templates, as JSON. Copy the JSON from the actor's page in
# the Apify console ("Input" tab -> JSON) and replace the values you want the app to
# drive with placeholders. Search: {{query}} {{zip}} {{address}} {{limit}}.
# Store: {{storeId}} {{storeUrl}} {{zip}} {{address}} {{item}}.
# Keep placeholders quoted so the template stays valid JSON — "{{limit}}" still
# renders as a number. Keys whose placeholder has no value are dropped before the run.
# APIFY_DOORDASH_INPUT={"startUrls":[{"url":"https://www.doordash.com/search/store/{{query:uri}}?event_type=search"}],"address":"{{address}}","maxResults":"{{limit}}","includeMenu":true,"fetchReviews":false}
# APIFY_DOORDASH_STORE_INPUT={"startUrls":[{"url":"{{storeUrl}}"}],"address":"{{address}}","includeMenu":true,"fetchReviews":false}

# Optional run tuning.
# Stores wanted per search run, rendered into the input as {{limit}}.
APIFY_MAX_ITEMS=20
APIFY_TIMEOUT_SEC=180
# Hard cap on dataset rows, enforced by Apify. Off by default: actors that emit one
# row per store *and* one per menu item would have their menus truncated by it.
# APIFY_HARD_MAX_ITEMS=0
# APIFY_MEMORY_MB=2048
# Over 300s (or APIFY_ASYNC=1) the client starts the run and polls instead of waiting inline.
# APIFY_ASYNC=0

# Apify deals layer (apps/api/src/deals). Non-secret settings are in apps/api/deals.config.json.
APIFY_API_KEY=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Random string; Apify sends it back as ?token= on the webhook so we can reject strangers.
APIFY_WEBHOOK_SECRET=change-me
# Bearer token Vercel Cron sends to /api/apify/reconcile.
CRON_SECRET=change-me
# Public URL of the deployed API, used to build the webhook URL passed to Apify.
API_PUBLIC_URL=https://your-api.vercel.app
